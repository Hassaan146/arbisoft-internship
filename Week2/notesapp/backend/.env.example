# Copy to .env and adjust. Never commit the real .env.
APP_NAME=Notes API
DATABASE_URL=sqlite:///./notes.db
# Comma-separated allowlist of frontend origins (no wildcard in prod).
CORS_ORIGINS=http://localhost:5173

# --- JWT auth ---
# Use at least 32 bytes (PyJWT warns below that). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Admin seed (created on startup if missing) ---
ADMIN_USERNAME=admin
ADMIN_PIN=1234

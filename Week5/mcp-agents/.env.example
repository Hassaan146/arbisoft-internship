# Week 5 — MCP + multi-agent config.
#
# Secrets are REUSED from Week4/research-agent/.env via ra_bridge (the
# research-agent's config.load_dotenv loads that file). You normally do not need
# to set anything here. Override only if you want Week 5 to use different values.
#
# GROQ_API_KEY=            # (falls back to Week4/research-agent/.env)
# SERPAPI_API_KEY=         # (falls back to Week4/research-agent/.env)
# MODEL=llama-3.3-70b-versatile

# Week-5-specific tunables (read by tracing.py / supervisor, with defaults):
# MCP_TRACE_PATH=agent_trace.jsonl   # where the cross-agent trace is written
# SUPERVISOR_MAX_STEPS=6             # supervisor routing budget
